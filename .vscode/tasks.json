{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build solution",
      "type": "shell",
      "command": "make build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start solution",
      "type": "shell",
      "command": "make start",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Test solution",
      "type": "shell",
      "command": "make test",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Start container to debug solution",
      "type": "shell",
      "command": "docker rm -f ${env:CONTAINER_NAME} 2>/dev/null || true && source .env && make start-debug",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true,
        "group": "debug"
      }
    }
  ]
}